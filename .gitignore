# Claude Code: local session state stays out of git; the shared settings and the
# hook scripts they run are committed
.claude/*
!.claude/settings.json
!.claude/hooks/

# Secrets — defense in depth; real config lives at ~/.expense-config
.expense-config
.env
.env.*
